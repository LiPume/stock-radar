# 只在后端配置；复制为 .env，保存在本机。
HITHINK_FINANCE_API_KEY=
HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn
SERVERCHAN_SENDKEY=
DATABASE_URL=sqlite:///./data/stock_radar.db
ADMIN_PASSWORD_HASH_FILE=data/admin.hash
SCHEDULER_ENABLED=true
# 交易时段逐股时间、复权、权益及 RSI 对照通过后才允许开启盘中取数。
INTRADAY_VALIDATED=false
# 行情商确认且实测通过的逐股成交时间字段（Unix 毫秒），默认留空。
HITHINK_VERIFIED_ROW_TIME_FIELD=
# 可选私有文件，映射证券代码至经核实的中文名称和来源网址。
SECURITY_MASTER_FILE=/var/lib/stock-radar/security-master.json
CORS_ORIGINS=https://lipume.github.io,http://localhost:5173,http://127.0.0.1:5173
